[Unit]
Description=Yozora Bar, a top panel for Hyprland
Documentation=https://github.com/ArunPrakashG/yozora
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/yozora-bar
Restart=on-failure
RestartSec=2
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target

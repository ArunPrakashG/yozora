# Maintainer: Arun Prakash <arun.prakash.456789@gmail.com>
pkgname=yozora-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Yozora: a top bar, notifications, a lock screen, a launcher and settings for Hyprland, built with GPUI, with a CLI and skill for AI agents"
arch=('x86_64' 'aarch64')
url="https://github.com/ArunPrakashG/yozora"
license=('MIT')
depends=('hyprland' 'wayland' 'libxkbcommon' 'fontconfig' 'freetype2' 'vulkan-icd-loader' 'dbus' 'pam' 'sqlite')
makedepends=('cargo' 'git' 'clang' 'cmake')
optdepends=(
  'pipewire-pulse: sound module (or pulseaudio)'
  'networkmanager: network module'
  'upower: battery module'
  'bluez: bluetooth module'
  'ttf-geist: the default font'
  'wl-clipboard: copying from the launcher'
  'cliphist: clipboard history in the launcher'
  'plocate: file search in the launcher'
  'xdg-utils: opening files and web searches from the launcher'
  'curl: currency rates in the launcher, Jev sorting in notifications'
  'libnotify: output of silent script commands in the launcher'
  'openssh: SSH hosts in the launcher'
  'python: the bundled modules (Claude sessions, CachyOS updates)'
  'pacman-contrib: the CachyOS updates module (checkupdates)'
)
provides=('yozora' 'notification-daemon')
conflicts=('yozora')
backup=('etc/pam.d/yozora-lock')
options=('!lto')
install=yozora.install
# scripts/release.sh points YOZORA_SOURCE at the local checkout, so a private repo builds too.
source=("yozora::${YOZORA_SOURCE:-git+${url}.git}")
sha256sums=('SKIP')

pkgver() {
  cd yozora
  # Tagged: v0.2.0 is 0.2.0, and 3 commits later 0.2.0.r3.gabc1234. Untagged: 0.1.0.rN.gabc1234.
  if tag=$(git describe --tags --long --match 'v[0-9]*' 2>/dev/null); then
    printf "%s" "$tag" | sed -E 's/^v//; s/-([0-9]+)-g/.r\1.g/; s/\.r0\.g[0-9a-f]+$//'
  else
    printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd yozora
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd yozora
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p yozora-bar -p yozora-notify -p yozora-lock -p yozora-launch -p yozora-settings -p yozora-cli -p yozora-idle
}

check() {
  cd yozora
  cargo test --frozen -p yozora-config -p yozora-ipc -p yozora-notify -p yozora-lock -p yozora-launch -p yozora-cli -p yozora-idle
}

package() {
  cd yozora
  install -Dm755 target/release/yozora-bar -t "$pkgdir/usr/bin"
  install -Dm755 target/release/yozora-notify -t "$pkgdir/usr/bin"
  install -Dm755 target/release/yozora-lock -t "$pkgdir/usr/bin"
  install -Dm755 target/release/yozora-launch -t "$pkgdir/usr/bin"
  install -Dm755 target/release/yozora-settings -t "$pkgdir/usr/bin"
  install -Dm755 target/release/yozora-idle -t "$pkgdir/usr/bin"
  install -Dm755 target/release/yozora -t "$pkgdir/usr/bin"

  install -Dm644 packaging/apps/bar.toml -t "$pkgdir/usr/share/yozora/apps"
  install -Dm644 packaging/apps/bar.settings.toml -t "$pkgdir/usr/share/yozora/apps"
  install -Dm644 packaging/apps/notify.toml -t "$pkgdir/usr/share/yozora/apps"
  install -Dm644 packaging/apps/notify.settings.toml -t "$pkgdir/usr/share/yozora/apps"
  install -Dm644 packaging/apps/lock.toml -t "$pkgdir/usr/share/yozora/apps"
  install -Dm644 packaging/apps/lock.settings.toml -t "$pkgdir/usr/share/yozora/apps"
  install -Dm644 packaging/apps/launch.toml -t "$pkgdir/usr/share/yozora/apps"
  install -Dm644 packaging/apps/launch.settings.toml -t "$pkgdir/usr/share/yozora/apps"
  install -Dm644 packaging/apps/idle.toml -t "$pkgdir/usr/share/yozora/apps"
  install -Dm644 packaging/apps/idle.settings.toml -t "$pkgdir/usr/share/yozora/apps"
  install -Dm644 packaging/pam/yozora-lock -t "$pkgdir/etc/pam.d"

  install -Dm644 packaging/desktop/yozora-settings.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/desktop/yozora-bar.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/icons/yozora-bar.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 packaging/icons/yozora-launch.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 packaging/icons/yozora-lock.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 packaging/icons/yozora-notify.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 packaging/icons/yozora.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 packaging/icons/yozora-settings.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"

  install -Dm644 packaging/systemd/yozora-bar.service -t "$pkgdir/usr/lib/systemd/user"
  install -Dm644 packaging/systemd/yozora-notify.service -t "$pkgdir/usr/lib/systemd/user"
  install -Dm644 packaging/systemd/yozora-launch.service -t "$pkgdir/usr/lib/systemd/user"
  install -Dm644 packaging/systemd/yozora-idle.service -t "$pkgdir/usr/lib/systemd/user"
  # Links the agent skill at every login, for every user, without anyone enabling it.
  install -Dm644 packaging/systemd/yozora-agent-skill.service -t "$pkgdir/usr/lib/systemd/user"
  install -dm755 "$pkgdir/usr/lib/systemd/user/default.target.wants"
  ln -s ../yozora-agent-skill.service "$pkgdir/usr/lib/systemd/user/default.target.wants/yozora-agent-skill.service"
  install -Dm644 packaging/agent/yozora/SKILL.md -t "$pkgdir/usr/share/yozora/agent/skills/yozora"
  install -Dm644 packaging/hyprland/yozora.lua -t "$pkgdir/usr/share/yozora/hyprland"
  install -Dm644 packaging/hyprland/yozora.conf -t "$pkgdir/usr/share/yozora/hyprland"

  # Bundled modules: scripts keep their exec bit, tests stay out of the package.
  for module in packaging/modules/*/; do
    name=$(basename "$module")
    for f in "$module"*; do
      case "$(basename "$f")" in
        test.sh) continue ;;
        *.sh|*.py) install -Dm755 "$f" -t "$pkgdir/usr/share/yozora/modules/$name" ;;
        *) install -Dm644 "$f" -t "$pkgdir/usr/share/yozora/modules/$name" ;;
      esac
    done
  done

  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 docs/*.md -t "$pkgdir/usr/share/doc/$pkgname"
}
